{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "lib": ["ESNext", "DOM"],
        "types": ["vite/client", "vitest/globals"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.vue",
        "tests/js/**/*.ts"
    ],
    "exclude": ["node_modules", "public", "vendor"]
}
